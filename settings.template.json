{
  "_comment": "Canonical 포터블 템플릿 — 손수 관리(라이브 settings에서 자동복사 금지). deploy.sh가 /home/click/.claude->$DST, /home/click/main->클론위치, 잔여 /home/click/->$HOME/ 로 경로치환. allow는 의도적으로 비움(권한=로컬 신뢰설정, 새 머신서 본인 opt-in). 보안 블록(attribution·deny·disable*·autoUploadSessions)은 no-cloud 정책(2026-07-26 사고)의 필수 이식분 — deploy.sh 머지가 기존 설치에도 강제 적용한다. sandbox는 의도적 미포함(2026-07-03c 결정: 머신별 bwrap/socat deps + failIfUnavailable fail-closed — 이식 후 수동 활성). 로컬 편의권한 예시는 settings.local.example.json 참고.",
  "env": {
    "LD_LIBRARY_PATH": "/home/click/.claude/tools/headless/chromedeps/usr/lib/x86_64-linux-gnu"
  },
  "attribution": {
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Artifact",
      "RemoteTrigger",
      "Read(//home/click/.secrets/**)",
      "Read(//home/click/.codex/auth.json)",
      "Read(//home/click/.claude/.credentials.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/api keys*)",
      "Read(**/api-keys*)",
      "Read(**/*credentials*.json)",
      "Read(**/id_rsa*)",
      "Read(**/*.pem)"
    ],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "disableArtifact": true,
  "autoUploadSessions": false,
  "remoteControlAtStartup": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/click/main/system/guardrail.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/click/main/system/subagent-log.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/click/main/system/recent-context.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/click/main/system/export-sessions.py >/dev/null 2>&1"
          },
          {
            "type": "command",
            "command": "python3 /home/click/main/system/skill-nudge.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/click/main/system/session-end-runner.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/click/main/system/uislop-check.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /home/click/main/system/skill-nudge.py"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "vercel@claude-plugins-official": true,
    "codex@openai-codex": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "theme": "dark-daltonized",
  "statusLine": {
    "type": "command",
    "command": "python3 /home/click/.claude/statusline.py"
  }
}
